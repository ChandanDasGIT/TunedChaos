[Desktop Entry]
Type=Application
Version=1.5
Name=Tuned Chaos
GenericName=Music Player
Comment=Play your music library, playlists and YouTube Music
Exec=TunedChaos %U
Icon=io.github.chandandasgit.TunedChaos
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/mp3;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;application/ogg;audio/mp4;audio/x-m4a;audio/aac;audio/x-aac;audio/wav;audio/x-wav;audio/vnd.wave;audio/x-ms-wma;audio/webm;audio/x-ape;audio/x-wavpack;audio/x-aiff;audio/x-mpegurl;audio/mpegurl;
Keywords=music;player;audio;playlist;lyrics;youtube;
StartupNotify=true
StartupWMClass=TunedChaos
SingleMainWindow=true
